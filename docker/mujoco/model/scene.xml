<!--
  Asterism rover (S1): the world. A floor, light, and a few landmarks for the
  camera: four coloured pillars on a 2 m circle around the start, and two
  boxes. MIT License (same as Family mruby).

  Start: the rover at the origin facing +x (the red pillar is straight ahead).
-->
<mujoco model="asterism_rover_scene">
  <include file="rover.xml"/>

  <!-- Elliptic friction cones and a high impratio keep the wheels from
       creeping (MuJoCo's soft contacts otherwise let them slip a few %). -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <statistic center="0 0 0.3" extent="4"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-25" offwidth="640" offheight="480"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.65 0.85" rgb2="0.1 0.1 0.15" width="512" height="3072"/>
    <texture type="2d" name="floor" builtin="checker" mark="edge" rgb1="0.75 0.75 0.72" rgb2="0.55 0.55 0.52"
             markrgb="0.3 0.3 0.3" width="300" height="300"/>
    <material name="floor" texture="floor" texuniform="true" texrepeat="2 2" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 4" dir="-0.3 0.2 -1" directional="true" diffuse="0.7 0.7 0.7" castshadow="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor" friction="1.0 0.005 0.0001"/>

    <!-- Landmarks: 1 m tall pillars, 2 m from the start -->
    <geom name="pillar_red" type="cylinder" size="0.1 0.5" pos="2 0 0.5" rgba="0.85 0.15 0.15 1"/>
    <geom name="pillar_green" type="cylinder" size="0.1 0.5" pos="0 2 0.5" rgba="0.15 0.7 0.2 1"/>
    <geom name="pillar_blue" type="cylinder" size="0.1 0.5" pos="-2 0 0.5" rgba="0.15 0.3 0.85 1"/>
    <geom name="pillar_yellow" type="cylinder" size="0.1 0.5" pos="0 -2 0.5" rgba="0.9 0.8 0.1 1"/>

    <!-- Boxes -->
    <geom name="box_purple" type="box" size="0.2 0.2 0.2" pos="1.5 1.2 0.2" euler="0 0 20" rgba="0.55 0.25 0.7 1"/>
    <geom name="box_cyan" type="box" size="0.15 0.3 0.15" pos="1.4 -1.3 0.15" euler="0 0 -30" rgba="0.1 0.7 0.75 1"/>
  </worldbody>
</mujoco>
